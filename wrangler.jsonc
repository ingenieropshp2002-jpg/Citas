{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reserva-citas",
  "main": "custom-worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Automatizaciones (recordatorios, reseñas, cumpleaños, suscripciones): cada 10 minutos. Aprobado por Inge el 2026-11-19.
  "triggers": { "crons": ["*/10 * * * *"] },
  // Base de datos en Supabase pneerwnctmwkfanugkwx (cuenta ingenieropshp2002) por Hyperdrive, sin caché. Aprobado por Inge el 2026-11-21.
  // La primera petición después del cambio copia todo desde la base anterior (DATABASE_URL), una sola vez (lib/migrar.ts).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "ed90a2661507406a98951ba8756bd3dd", "localConnectionString": "postgresql://x:y@localhost:5432/z" }],
  "vars": { "DB_SCHEMA": "citas", "DB_HYPERDRIVE": "1" }
}
