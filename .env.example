# Base de datos PostgreSQL (Supabase). DATABASE_URL = Transaction pooler (puerto 6543); DIRECT_URL = Session pooler (5432) para migraciones
DATABASE_URL="postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres"
DB_SCHEMA="citas"
# Secreto para firmar sesiones (cámbielo: openssl rand -hex 32)
AUTH_SECRET="cambie-este-secreto-por-uno-largo-y-aleatorio"
APP_URL="http://localhost:3000"

# Pasarela de pagos: SIMULADO | WOMPI | MERCADOPAGO
PAYMENT_PROVIDER="SIMULADO"
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
WOMPI_ENV="sandbox"   # sandbox | production
MERCADOPAGO_ACCESS_TOKEN=""

# Mensajería (WhatsApp Cloud API de Meta). Vacío = los mensajes se registran en consola
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
# Webhook para confirmar citas respondiendo 1/2 y reserva por WhatsApp: https://SU-DOMINIO/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
# Plantillas aprobadas por Meta (opcional, necesarias fuera de la ventana de 24 h)
WHATSAPP_TPL_RECORDATORIO=""   # parámetros: nombre, negocio, fecha y hora, profesional
WHATSAPP_TPL_CUMPLEANOS=""     # parámetros: nombre, negocio
WHATSAPP_TPL_RECUPERAR=""      # parámetros: nombre, negocio
WHATSAPP_TPL_LANG="es"

# Suscripciones: correos de administradores de la plataforma (separados por coma) y precios mensuales
ADMIN_EMAILS=""
PLAN_PRICE_BASICO="49900"
PLAN_PRICE_PRO="99900"
PLAN_PRICE_PREMIUM="189900"

# Login con Google (opcional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Ingreso con Apple (Services ID, Team ID, Key ID y el contenido del archivo .p8)
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
CRON_SECRET=""
